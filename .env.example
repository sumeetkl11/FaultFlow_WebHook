# FaultFlow Production & Local Development Environment Template
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Database & Redis Connections
DATABASE_URL=postgresql://faultflow_admin:change_me_secret@localhost:5432/faultflow_db
REDIS_URL=redis://localhost:6379

# Multi-Tenant Ingress Keys (Generate strong cryptographically random strings for production)
DEFAULT_TENANT_ID=org_live_faultflow_demo
DEFAULT_API_KEY=org_live_sk_generate_strong_secret_key_here
DEFAULT_SIGNING_SECRET=whsec_generate_strong_signing_secret_here

# Ingress & Delivery Engine Tuning
MAX_PAYLOAD_INLINE_BYTES=4096
DEFAULT_MAX_RETRIES=5
DEFAULT_TIMEOUT_MS=5000
DLQ_REPLAY_MAX_RPS=50

# Security & Reverse Proxy Settings
TRUSTED_PROXY_COUNT=1
CORS_ALLOWED_ORIGINS=http://localhost:3000
ALLOW_LOCAL_WEBHOOKS=false
